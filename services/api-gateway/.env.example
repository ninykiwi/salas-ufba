# Servidor
PORT=3001

# Origens permitidas para CORS (separadas por vírgula)
# Se não definida, usa http://localhost:3000 como padrão em desenvolvimento
ALLOWED_ORIGINS=http://localhost:3000

# URL do auth-service para onde as rotas /auth, /users e /institutes são proxeadas
# Se não definida, usa http://localhost:3002 como padrão em desenvolvimento
AUTH_SERVICE_URL=http://localhost:3002
