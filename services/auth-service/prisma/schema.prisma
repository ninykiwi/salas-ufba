datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  PROFESSOR
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  siape      String?     @unique
  password   String
  role       Role        @default(PROFESSOR)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  institutes Institute[]

  @@map("users")
}

model Institute {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  floors    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("institutes")
}
